# Frontend (public — baked into client/SSG at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Google Search Console HTML-tag token (emits <meta name="google-site-verification">)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Frontend — when Nest contact API exists (uncomment when wired)
# CONTACT_API_URL=http://localhost:3001

# Backend only — never prefix with NEXT_PUBLIC_
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=iamhosseinkhalili@gmail.com
# EMAIL_FROM=noreply@yourdomain.com
